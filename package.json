  "type": "module",
  "scripts": {
    "build": "node scripts/generate_validators.mjs && npm run check && node scripts/build_web.mjs",
    "check": "node scripts/generate_validators.mjs --check && tsc -p tsconfig.json --noEmit",
    "test:web": "node tests/web_i18n.mjs && node tests/web_models.mjs && node tests/web_contract.mjs all",
    "accept:web": "node scripts/accept_frontend.mjs"
  },
  "dependencies": {
