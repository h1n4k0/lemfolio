      "type": "object",
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "accept",
            "reject"
          ]
        },
        "digest": {
          "type": "string"
        },
        "engine": {
          "type": "string",
          "enum": [
            "pdflatex",
            "xelatex",
            "lualatex"
          ],
          "default": "pdflatex"
        }
      },
      "required": [
        "decision",
        "digest"
      ],
      "additionalProperties": false
    },
    "TaskInput": {
      "type": "object",
      "properties": {
        "intent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "mode": {
          "type": "string",
          "enum": [
            "chat",
            "edit",
            "math",
            "literature",
            "review"
          ],
          "default": "chat"
        },
        "provider": {
          "type": "string",
          "default": "codex",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 160
            },
            {
              "type": "null"
            }
