      "type": "object",
      "properties": {
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Change"
          },
          "minItems": 1,
          "maxItems": 100
        },
        "base_revision": {
          "type": "string"
        },
        "base_state_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
