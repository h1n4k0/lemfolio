{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lemfolio.local/contracts/v1/schema.json",
  "title": "Lemfolio protocol v1",
  "contract_version": "1.0.0",
  "$defs": {
    "TextEdit": {
      "type": "object",
      "properties": {
        "old_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000000
        },
        "new_text": {
          "type": "string",
          "maxLength": 2000000
        }
      },
      "required": [
        "old_text",
        "new_text"
      ],
      "additionalProperties": false
    },
    "Change": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "content": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000000
            },
            {
              "type": "null"
            }
          ]
        },
        "edits": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TextEdit"
              },
              "minItems": 1,
              "maxItems": 100
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "content"
          ],
          "properties": {
            "edits": {
              "type": "null"
            },
            "content": {}
          }
        },
        {
          "required": [
            "edits"
          ],
          "properties": {
            "content": {
              "type": "null"
            },
            "edits": {
              "type": "array",
              "minItems": 1
            }
          }
        }
      ]
    },
    "AgentChange": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "content": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000000
            },
            {
              "type": "null"
            }
          ]
        },
        "edits": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TextEdit"
              },
              "minItems": 1,
              "maxItems": 100
