            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "path",
        "content",
        "edits"
      ],
      "additionalProperties": false
    },
    "AgentResult": {
      "type": "object",
      "properties": {
        "answer": {
          "type": "string"
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentChange"
          },
          "maxItems": 100
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 100
        },
        "suggested_reply": {
          "type": "string",
          "maxLength": 300
        }
      },
      "required": [
        "answer",
        "changes",
        "checks",
        "suggested_reply"
      ],
      "additionalProperties": false
    },
    "Selection": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
