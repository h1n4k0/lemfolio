{
  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "outDir": "web", "rootDir": "frontend", "noEmitOnError": true,
    "verbatimModuleSyntax": true, "jsx": "react-jsx", "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["frontend/**/*.ts", "frontend/**/*.tsx"]
}
